  "canonicalization_profile": "keel.canonical_json.payload.v1",
  "contract": "This corpus is the normative, machine-checkable contract for offline re-derivation of a payment identity from a classified tool call. A verifier conforms iff it produces the expected outcome for every vector. The sibling recipe document explains it; this corpus decides it.",
  "outcomes": [
    "valid",
    "no_derivation",
    "invalid",
    "unverifiable"
  ],
  "vectors": [
    {
      "id": "positive-payments-value-movement",
      "title": "Enforced payments value-movement tool derives payment.execute",
      "facts": {
        "invocation": {
          "operation": "call.tools",
          "transport": "mcp",
          "connector_identity": "payments",
          "canonical_tool_name": "authorize_payment"
        },
        "classification": {
          "class": "value_movement",
          "subject": {
            "kind": "registered_tool",
            "connector_identity": "payments",
            "canonical_tool_name": "authorize_payment"
          },
          "provenance": {
            "registry": {
              "artifact_id": "keel.permit.value_movement_classification.v1",
              "artifact_version": "v1",
              "artifact_digest": "sha256:c46b8bd165ef16c284621e5349b22e5621fe66c4a25a3c8b18c8d88e20de76d0"
            },
            "input": {
              "profile": "keel.registered_tool_classification_input.v1",
              "digest": "sha256:f0ba6cc4dd39652b29a20e5a157f75dde7928034eae0828b914e5140914900ae"
            }
          }
        },
        "control": {
          "mode": "enforced_in_path"
        }
      },
      "expected": {
        "outcome": "valid",
        "authorized_action": "payment.execute"
      }
    },
