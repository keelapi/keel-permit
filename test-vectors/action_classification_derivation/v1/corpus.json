  "classification_registry_digest": "sha256:c46b8bd165ef16c284621e5349b22e5621fe66c4a25a3c8b18c8d88e20de76d0",
  "canonicalization_profile": "keel.canonical_json.payload.v1",
  "given_model": "Each vector's `given.trusted_registry_digests` is the set of classification_registry digests the verifier pins (has, and accepts as authentic). Dependency resolution (algorithm step 4) resolves ONLY a digest in this set; a digest outside it is unverifiable, regardless of whether some party can supply bytes hashing to it. This makes every resolution outcome a function of (signed record, trusted set), never of incidental local inventory.",
  "conformance": "Passing every vector is NECESSARY, NOT SUFFICIENT. The ruleset decision_algorithm plus profile/grammar definitions are the complete contract; this corpus is mandatory minimum evidence. reference_executor.py in this directory runs the algorithm against every vector purely from the spec.",
  "outcomes": [
    "valid",
    "no_derivation",
    "invalid",
    "unverifiable"
  ],
  "deferred_coverage": "multiple-applicable-rules (synthetic 2-rule fixture; lands with the second Permit-to-X rule) and property/generated tests are broader-assurance, co-designed with the reference verifier. Named so their absence is explicit.",
