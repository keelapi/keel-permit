{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/keelapi/keel-permit/schemas/work-binding-v2.schema.json",
  "title": "Keel Work child binding v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root_permit_id",
    "authority_id",
    "authority_canonical_hash",
    "root_manifest_hash",
    "exercised_by"
  ],
  "properties": {
    "version": {"const": "keel.work_binding.v2"},
    "root_permit_id": {"type": "string", "format": "uuid"},
    "authority_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "authority_canonical_hash": {"$ref": "#/$defs/digest"},
    "root_manifest_hash": {"$ref": "#/$defs/digest"},
    "exercised_by": {"$ref": "#/$defs/exercised_by"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "exercised_by": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verified_principal_id",
        "root_principal_id",
        "delegated_principal_id",
        "delegation_id",
        "authenticated_credential_id_digest"
      ],
      "properties": {
        "verified_principal_id": {"type": "string", "format": "uuid"},
        "root_principal_id": {"type": "string", "format": "uuid"},
        "delegated_principal_id": {"type": ["string", "null"], "format": "uuid"},
        "delegation_id": {"type": ["string", "null"], "format": "uuid"},
        "authenticated_credential_id_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
